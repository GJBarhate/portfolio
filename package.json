{
  "name": "gaurav-barhate-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/check-encoding.mjs && node scripts/gen-sitemap.mjs && node scripts/gen-critical.mjs --check && node scripts/gen-structured-data.mjs --check",
    "build": "vite build && node scripts/check-budgets.mjs && node scripts/check-canonical.mjs && node scripts/check-csp.mjs",
    "build:only": "vite build",
    "preview": "vite preview",
    "gen:critical": "node scripts/gen-critical.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "check:budgets": "node scripts/check-budgets.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:canonical": "node scripts/check-canonical.mjs",
    "check:overflow": "node scripts/check-overflow.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:breakpoints": "node scripts/check-breakpoints.mjs",
    "check:effects": "node scripts/check-effect-budget.mjs",
    "check:attrs": "node scripts/check-attr-selectors.mjs",
    "check:dupes": "node scripts/check-css-dupes.mjs",
    "check:all": "npm run lint && npm run build && npm test && npm run check:encoding && npm run check:contrast && npm run check:breakpoints && npm run check:effects && npm run check:overflow && npm run check:layout && npm run check:attrs && npm run check:dupes && npm run check:parity && npm run check:colorspace && npm run check:structured",
    "lint": "eslint .",
    "check:csp": "node scripts/check-csp.mjs",
    "gen:structured": "node scripts/gen-structured-data.mjs",
    "check:structured": "node scripts/gen-structured-data.mjs --check",
    "check:colorspace": "node scripts/check-color-space.mjs",
    "check:parity": "node scripts/check-appearance-parity.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^11.11.17",
    "matter-js": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vite-imagetools": "^7.1.1",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10",
    "web-vitals": "^6.0.1"
  }
}
